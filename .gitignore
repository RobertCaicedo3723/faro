# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars*
!.env.example
/entregas/
/evidencias/
/qa/
/artifacts-build/
*.tsbuildinfo
__pycache__/
*.pyc

# vercel
.vercel

# typescript
next-env.d.ts

# Maintained Vite plugin and worker sources.
!/build/
/build/*
!/build/connector-preview-plugin.mjs
!/build/connector-preview-worker.mjs
!/build/sites-vite-plugin.LICENSE
!/build/sites-vite-plugin.ts
!/build/sites-worker.ts

/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Registro interno de operación y preparación de entregas.
/PLAN-DISPONIBILIDAD.md
/docs/OPERACION-SERVIDOR.md
/scripts/empaquetar-rediseno.py
/scripts/preparar-entrega-docente.py
/scripts/preparar-word-docente.py
/scripts/redisenar-entregas.py
/scripts/redisenar-presentacion.mjs

# Flujo opcional conservado localmente; la sesión actual no concede workflow.
/.github/workflows/tests.yml
